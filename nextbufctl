#!/bin/sh
set -eu
umask 077

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
cd "$ROOT"

COMPOSE_FILE=${NEXTBUF_COMPOSE_FILE:-compose.yml}
ENV_FILE=${NEXTBUF_ENV_FILE:-.env}
BACKUP_DIR=${NEXTBUF_BACKUP_DIR:-$ROOT/backups}

die() {
  printf 'nextbufctl: %s\n' "$*" >&2
  exit 1
}

info() {
  printf 'nextbufctl: %s\n' "$*"
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"
}

require_files() {
  [ -f "$COMPOSE_FILE" ] || die "missing $COMPOSE_FILE"
  [ -f "$ENV_FILE" ] || die "missing $ENV_FILE; run ./nextbufctl init first"
}

is_exact_semver() {
  printf '%s' "$1" | grep -Eq '^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(-((0|[1-9][0-9]*)|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(\.((0|[1-9][0-9]*)|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?$'
}

semver_compare() {
  left=$1
  right=$2
  LC_ALL=C awk -v left="$left" -v right="$right" '
    function compare_numeric(left_value, right_value) {
      if (length(left_value) < length(right_value)) return -1
      if (length(left_value) > length(right_value)) return 1
      if (("x" left_value) < ("x" right_value)) return -1
      if (("x" left_value) > ("x" right_value)) return 1
      return 0
    }
    function split_version(value, core, pre, marker) {
      marker = index(value, "-")
      if (marker == 0) {
        core[1] = value
        pre[1] = ""
      } else {
        core[1] = substr(value, 1, marker - 1)
        pre[1] = substr(value, marker + 1)
      }
    }
    function compare_prerelease(left_pre, right_pre, left_parts, right_parts, left_count, right_count, count, i, left_numeric, right_numeric) {
      if (left_pre == "" && right_pre == "") return 0
      if (left_pre == "") return 1
      if (right_pre == "") return -1
      left_count = split(left_pre, left_parts, ".")
      right_count = split(right_pre, right_parts, ".")
      count = left_count > right_count ? left_count : right_count
      for (i = 1; i <= count; i++) {
        if (i > left_count) return -1
        if (i > right_count) return 1
        left_numeric = left_parts[i] ~ /^[0-9]+$/
        right_numeric = right_parts[i] ~ /^[0-9]+$/
        if (left_numeric && right_numeric) {
          numeric_result = compare_numeric(left_parts[i], right_parts[i])
          if (numeric_result != 0) return numeric_result
        } else if (left_numeric != right_numeric) {
          return left_numeric ? -1 : 1
        } else {
          if (("x" left_parts[i]) < ("x" right_parts[i])) return -1
          if (("x" left_parts[i]) > ("x" right_parts[i])) return 1
        }
      }
      return 0
    }
    BEGIN {
      split_version(left, left_core_value, left_pre_value)
      split_version(right, right_core_value, right_pre_value)
      split(left_core_value[1], left_core, ".")
      split(right_core_value[1], right_core, ".")
      for (i = 1; i <= 3; i++) {
        core_result = compare_numeric(left_core[i], right_core[i])
        if (core_result != 0) { print core_result; exit }
      }
      print compare_prerelease(left_pre_value[1], right_pre_value[1])
    }
  '
}

compose() {
  NEXTBUF_ENV_FILE="$ENV_FILE" docker compose --env-file "$ENV_FILE" -f "$COMPOSE_FILE" "$@"
}

compose_for_version() {
  requested_version=$1
  shift
  NEXTBUF_VERSION="$requested_version" NEXTBUF_ENV_FILE="$ENV_FILE" \
    docker compose --env-file "$ENV_FILE" -f "$COMPOSE_FILE" "$@"
}

acquire_operation_lock() {
  require_command flock
  lock_file="$ROOT/.nextbufctl.lock"
  exec 9>"$lock_file"
  chmod 600 "$lock_file"
  flock -n 9 || die "another NextBuf operation is already running"
}

env_get() {
  sed -n "s/^$1=//p" "$ENV_FILE" | tail -n 1
}

env_set() {
  key=$1
  value=$2
  temp="$ENV_FILE.tmp.$$"
  awk -v key="$key" -v value="$value" '
    BEGIN { found = 0 }
    index($0, key "=") == 1 { print key "=" value; found = 1; next }
    { print }
    END { if (!found) print key "=" value }
  ' "$ENV_FILE" >"$temp"
  chmod 600 "$temp"
  mv "$temp" "$ENV_FILE"
}

random_hex() {
  if command -v openssl >/dev/null 2>&1; then
    openssl rand -hex "$1"
  else
    od -An -N "$1" -tx1 /dev/urandom | tr -d ' \n'
  fi
}

random_base64_32() {
  if command -v openssl >/dev/null 2>&1; then
    openssl rand -base64 32 | tr -d '\n'
  else
    dd if=/dev/urandom bs=32 count=1 2>/dev/null | base64 | tr -d '\n'
  fi
}

is_placeholder() {
  value=$1
  [ -z "$value" ] || printf '%s' "$value" | grep -Eq '^(replace-|generate-|change-me|example)'
}

wait_for_service() {
  service=$1
  timeout=${2:-120}
  started=$(date +%s)
  while :; do
    id=$(compose ps -q "$service" 2>/dev/null || true)
    if [ -n "$id" ]; then
      status=$(docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' "$id" 2>/dev/null || true)
      [ "$status" = healthy ] && return 0
      [ "$status" = exited ] && die "$service exited before becoming healthy"
    fi
    now=$(date +%s)
    [ $((now - started)) -lt "$timeout" ] || die "timed out waiting for $service"
    sleep 2
  done
}

service_is_running() {
  service=$1
  id=$(compose ps -q "$service" 2>/dev/null || true)
  [ -n "$id" ] || return 1
  [ "$(docker inspect --format '{{.State.Running}}' "$id" 2>/dev/null || true)" = true ]
}

resume_app_services() {
  resume_web=$1
  resume_worker=$2
  if [ "$resume_web" = 1 ]; then
    compose up -d --no-deps web
    wait_for_service web 180
  fi
  if [ "$resume_worker" = 1 ]; then
    compose up -d --no-deps worker
    wait_for_service worker 180
  fi
}

resume_app_services_best_effort() {
  resume_web=$1
  resume_worker=$2
  services=
  if [ "$resume_web" = 1 ]; then services="web"; fi
  if [ "$resume_worker" = 1 ]; then services="$services worker"; fi
  if [ -n "$services" ]; then
    # shellcheck disable=SC2086
    compose up -d --no-deps $services >/dev/null 2>&1 || true
  fi
}

confirm_destructive() {
  [ "${NEXTBUFCTL_ASSUME_YES:-0}" = 1 ] && return 0
  printf '%s [type YES]: ' "$1" >&2
  read -r answer
  [ "$answer" = YES ] || die "operation cancelled"
}

do_init() {
  require_command docker
  docker compose version >/dev/null 2>&1 || die "Docker Compose v2 is required"
  [ -f "$ENV_FILE" ] || {
    [ -f .env.example ] || die "missing .env.example"
    cp .env.example "$ENV_FILE"
  }
  chmod 600 "$ENV_FILE"

  for key in POSTGRES_PASSWORD REDIS_PASSWORD AUTH_SECRET SETUP_TOKEN; do
    value=$(env_get "$key")
    if is_placeholder "$value"; then env_set "$key" "$(random_hex 32)"; fi
  done
  value=$(env_get MAIL_PAYLOAD_KEY)
  if is_placeholder "$value"; then env_set MAIL_PAYLOAD_KEY "$(random_base64_32)"; fi

  postgres_user=$(env_get POSTGRES_USER)
  postgres_password=$(env_get POSTGRES_PASSWORD)
  postgres_db=$(env_get POSTGRES_DB)
  redis_password=$(env_get REDIS_PASSWORD)
  env_set DATABASE_URL "postgresql://$postgres_user:$postgres_password@postgres:5432/$postgres_db"
  env_set DATABASE_DIRECT_URL "postgresql://$postgres_user:$postgres_password@postgres:5432/$postgres_db"
  env_set REDIS_URL "redis://:$redis_password@redis:6379/0"

  mkdir -p "$BACKUP_DIR"
  chmod 700 "$BACKUP_DIR"
  compose config --quiet
  info "configuration initialized in $ENV_FILE"
  info "edit APP_URL, SMTP_* and storage settings before running ./nextbufctl start"
}

do_start() {
  require_files
  compose config --quiet
  compose pull
  # Remove a legacy panel-visible one-shot container if it still exists.
  compose rm -sf setup >/dev/null 2>&1 || true
  compose up -d postgres redis web worker
  wait_for_service web 180
  wait_for_service worker 180
  info "NextBuf is running. Complete first administrator setup at $(env_get APP_URL)/setup"
}

do_stop() {
  require_files
  compose stop web worker
}

do_status() {
  require_files
  compose ps
}

do_logs() {
  require_files
  service=${1:-}
  case "$service" in
    web|worker|postgres|redis|setup) compose logs --tail 200 -f "$service" ;;
    "") compose logs --tail 200 -f web worker ;;
    *) die "logs service must be web, worker, postgres, redis or setup" ;;
  esac
}

do_doctor() {
  require_files
  compose --profile tools run --rm --no-deps doctor
}

verify_image_version() {
  image_probe_requested_version=$1
  if ! image_probe_reported_version=$(compose_for_version "$image_probe_requested_version" run --rm --no-deps setup version); then
    printf 'nextbufctl: target image version probe failed: %s\n' \
      "$image_probe_requested_version" >&2
    return 1
  fi
  image_probe_reported_version=$(printf '%s' "$image_probe_reported_version" | tr -d '\r')
  if [ "$image_probe_reported_version" != "$image_probe_requested_version" ]; then
    printf 'nextbufctl: target image reports %s instead of %s\n' \
      "$image_probe_reported_version" "$image_probe_requested_version" >&2
    return 1
  fi
}

write_evidence_checksum() {
  checksum_file=$1
  checksum_directory=$(dirname "$checksum_file")
  checksum_basename=$(basename "$checksum_file")
  (
    cd "$checksum_directory"
    sha256sum "$checksum_basename" >"$checksum_basename.SHA256"
    chmod 600 "$checksum_basename.SHA256"
  )
}

capture_acceptance_snapshot() {
  requested_version=$1
  output=$2
  verify_objects=${3:-0}
  partial="$output.partial.$$"
  rm -f "$partial"
  if [ "$verify_objects" = 1 ]; then
    if ! compose_for_version "$requested_version" run --rm --no-deps setup \
      acceptance snapshot --verify-objects >"$partial"; then
      rm -f "$partial"
      return 1
    fi
  elif ! compose_for_version "$requested_version" run --rm --no-deps setup \
    acceptance snapshot >"$partial"; then
    rm -f "$partial"
    return 1
  fi
  [ -s "$partial" ] || {
    rm -f "$partial"
    return 1
  }
  chmod 600 "$partial"
  mv "$partial" "$output"
}

compare_acceptance_snapshots() {
  requested_version=$1
  before=$2
  after=$3
  output=$4
  before_absolute=$(realpath "$before")
  after_absolute=$(realpath "$after")
  partial="$output.partial.$$"
  rm -f "$partial"
  status=0
  compose_for_version "$requested_version" run --rm --no-deps \
    --user "$(id -u):$(id -g)" \
    -v "$before_absolute:/nextbuf-evidence/before.json:ro" \
    -v "$after_absolute:/nextbuf-evidence/after.json:ro" \
    setup acceptance compare \
    /nextbuf-evidence/before.json /nextbuf-evidence/after.json >"$partial" || status=$?
  if [ -s "$partial" ]; then
    chmod 600 "$partial"
    mv "$partial" "$output"
  else
    rm -f "$partial"
  fi
  return "$status"
}

do_acceptance() {
  require_files
  action=${1:-}
  if [ "$#" -gt 0 ]; then shift; fi
  case "$action" in
    capture)
      requested_version=${1:-}
      [ "$#" -gt 0 ] && shift
      is_exact_semver "$requested_version" ||
        die "usage: ./nextbufctl acceptance capture <image-version> [--verify-objects]"
      verify_objects=0
      if [ "${1:-}" = --verify-objects ]; then
        verify_objects=1
        shift
      fi
      [ "$#" -eq 0 ] ||
        die "usage: ./nextbufctl acceptance capture <image-version> [--verify-objects]"
      if service_is_running web || service_is_running worker; then
        die "acceptance capture requires Web and Worker to be stopped"
      fi
      require_command realpath
      require_command sha256sum
      mkdir -p "$BACKUP_DIR"
      chmod 700 "$BACKUP_DIR"
      compose_for_version "$requested_version" pull setup
      verify_image_version "$requested_version" || die "target image version validation failed"
      wait_for_service postgres 180
      stamp=$(date -u +%Y%m%dT%H%M%SZ)
      configured_version=$(env_get NEXTBUF_VERSION)
      is_exact_semver "$configured_version" ||
        die "current NEXTBUF_VERSION is not an exact SemVer: $configured_version"
      output="$BACKUP_DIR/acceptance-$configured_version-$stamp-$$.json"
      capture_acceptance_snapshot "$requested_version" "$output" "$verify_objects" ||
        die "acceptance snapshot failed"
      write_evidence_checksum "$output"
      info "acceptance snapshot completed: $output"
      ;;
    compare)
      requested_version=${1:-}
      before=${2:-}
      after=${3:-}
      [ "$#" -eq 3 ] && is_exact_semver "$requested_version" ||
        die "usage: ./nextbufctl acceptance compare <image-version> <before.json> <after.json>"
      [ -f "$before" ] || die "acceptance snapshot not found: $before"
      [ -f "$after" ] || die "acceptance snapshot not found: $after"
      require_command realpath
      require_command sha256sum
      require_command id
      compose_for_version "$requested_version" pull setup
      verify_image_version "$requested_version" || die "target image version validation failed"
      mkdir -p "$BACKUP_DIR"
      chmod 700 "$BACKUP_DIR"
      stamp=$(date -u +%Y%m%dT%H%M%SZ)
      output="$BACKUP_DIR/acceptance-comparison-$stamp-$$.json"
      if ! compare_acceptance_snapshots "$requested_version" "$before" "$after" "$output"; then
        if [ -f "$output" ]; then
          write_evidence_checksum "$output" || true
          cat "$output" >&2
        fi
        die "acceptance comparison found invariant changes"
      fi
      write_evidence_checksum "$output"
      info "acceptance comparison completed: $output"
      ;;
    *)
      die "usage: ./nextbufctl acceptance <capture|compare>"
      ;;
  esac
}

do_backup() {
  keep_stopped=${1:-0}
  require_files
  require_command tar
  require_command sha256sum
  mkdir -p "$BACKUP_DIR"
  chmod 700 "$BACKUP_DIR"
  stamp=$(date -u +%Y%m%dT%H%M%SZ)
  version=$(env_get NEXTBUF_VERSION)
  is_exact_semver "$version" || die "NEXTBUF_VERSION is not an exact SemVer: $version"
  temp=$(mktemp -d "$BACKUP_DIR/.nextbuf-backup.XXXXXX")
  partial=
  resume_web=0
  resume_worker=0
  if service_is_running web; then resume_web=1; fi
  if service_is_running worker; then resume_worker=1; fi
  backup_abort() {
    status=$?
    [ "$status" -ne 0 ] || status=1
    trap - EXIT HUP INT TERM
    rm -rf "$temp"
    if [ -n "$partial" ]; then rm -f "$partial"; fi
    resume_app_services_best_effort "$resume_web" "$resume_worker"
    exit "$status"
  }
  trap backup_abort EXIT HUP INT TERM
  database_kb=$(compose exec -T postgres sh -ec 'psql -U "$POSTGRES_USER" -d "$POSTGRES_DB" -Atc "SELECT CEIL(pg_database_size(current_database()) / 1024.0)::bigint"' | tr -d '\r')
  if [ "$(env_get STORAGE_DRIVER)" = local ]; then
    uploads_kb=$(compose run --rm --no-deps --entrypoint sh setup -ec 'du -sk /app/data/uploads | cut -f1')
  else
    uploads_kb=0
  fi
  available_kb=$(df -Pk "$BACKUP_DIR" | awk 'NR == 2 { print $4 }')
  required_kb=$(((database_kb + uploads_kb) * 2 + 102400))
  [ "$available_kb" -gt "$required_kb" ] || die "insufficient free space for backup: need at least ${required_kb} KiB"
  info "stopping Web and Worker to create a database/attachment-consistent backup"
  compose stop web worker >/dev/null
  if service_is_running web || service_is_running worker; then
    die "Web or Worker is still running; consistency backup aborted"
  fi
  info "creating PostgreSQL dump"
  compose exec -T postgres sh -ec 'exec pg_dump -U "$POSTGRES_USER" -d "$POSTGRES_DB" --format=custom --no-owner --no-privileges' >"$temp/database.dump"
  compose exec -T postgres sh -ec 'exec pg_restore --list' <"$temp/database.dump" >"$temp/database.list"
  [ -s "$temp/database.list" ] || die "PostgreSQL dump validation produced an empty object list"
  cp "$ENV_FILE" "$temp/config.env"
  chmod 600 "$temp/config.env"
  cp "$COMPOSE_FILE" "$temp/compose.yml"
  if [ "$(env_get STORAGE_DRIVER)" = local ]; then
    compose run --rm --no-deps --entrypoint sh setup -ec 'tar -C /app/data/uploads -czf - .' >"$temp/uploads.tar.gz"
    tar -tzf "$temp/uploads.tar.gz" >"$temp/uploads.list"
    compose run --rm --no-deps --entrypoint sh setup -ec 'cd /app/data/uploads; find . -type f -print0 | LC_ALL=C sort -z | xargs -0 -r sha256sum' >"$temp/uploads.SHA256SUMS"
    attachments=true
    attachment_files="uploads.tar.gz uploads.list uploads.SHA256SUMS"
  else
    printf 'driver=s3\nbucket=%s\nendpoint=%s\n' "$(env_get S3_BUCKET)" "$(env_get S3_ENDPOINT)" >"$temp/storage-s3.txt"
    attachments=false
    attachment_files=storage-s3.txt
  fi
  postgres_version=$(compose exec -T postgres sh -ec 'psql -U "$POSTGRES_USER" -d "$POSTGRES_DB" -Atc "SHOW server_version"' | tr -d '\r')
  migration=$(compose exec -T postgres sh -ec 'psql -U "$POSTGRES_USER" -d "$POSTGRES_DB" -Atc "SELECT migration_name FROM _prisma_migrations WHERE finished_at IS NOT NULL AND rolled_back_at IS NULL ORDER BY finished_at DESC LIMIT 1"' | tr -d '\r')
  cat >"$temp/manifest.json" <<EOF
  {"format":"nextbuf-backup-v1","createdAt":"$stamp","applicationVersion":"$version","postgresVersion":"$postgres_version","latestMigration":"$migration","writeProcessesStopped":true,"databaseList":"database.list","attachmentsIncluded":$attachments}
EOF
  (cd "$temp" && sha256sum database.dump database.list config.env compose.yml manifest.json $attachment_files >SHA256SUMS)
  archive="$BACKUP_DIR/nextbuf-$version-$stamp-$$.tar.gz"
  partial="$archive.partial"
  tar -C "$temp" -czf "$partial" .
  tar -tzf "$partial" >/dev/null
  chmod 600 "$partial"
  mv "$partial" "$archive"
  rm -rf "$temp"
  if [ "$keep_stopped" != 1 ]; then
    resume_app_services "$resume_web" "$resume_worker"
  fi
  if [ "$keep_stopped" != 1 ]; then
    trap - EXIT HUP INT TERM
  fi
  LAST_BACKUP=$archive
  export LAST_BACKUP
  info "backup completed: $archive"
}

do_restore() {
  require_files
  archive=${1:-}
  [ -n "$archive" ] || die "usage: ./nextbufctl restore <backup-file> [--empty-install] [--restore-config] [--yes]"
  shift || true
  empty=0
  restore_config=0
  for option in "$@"; do
    case "$option" in
      --empty-install) empty=1 ;;
      --restore-config) restore_config=1 ;;
      --yes) NEXTBUFCTL_ASSUME_YES=1 ;;
      *) die "unknown restore option: $option" ;;
    esac
  done
  [ -f "$archive" ] || die "backup not found: $archive"
  require_command tar
  require_command sha256sum
  if tar -tzf "$archive" | grep -Eq '(^/|(^|/)\.\.(/|$))'; then die "unsafe path in backup archive"; fi
  temp=$(mktemp -d "${TMPDIR:-/tmp}/nextbuf-restore.XXXXXX")
  trap 'rm -rf "$temp"' EXIT HUP INT TERM
  tar -C "$temp" -xzf "$archive"
  (cd "$temp" && sha256sum -c SHA256SUMS)
  [ -f "$temp/database.dump" ] || die "backup has no PostgreSQL dump"
  [ -f "$temp/manifest.json" ] || die "backup has no manifest"
  compose run --rm --no-deps --entrypoint pg_restore postgres --list <"$temp/database.dump" >/dev/null
  info "restore manifest: $(cat "$temp/manifest.json")"
  if [ -f "$temp/uploads.tar.gz" ] && tar -tzf "$temp/uploads.tar.gz" | grep -Eq '(^/|(^|/)\.\.(/|$))'; then
    die "unsafe path in attachment archive"
  fi
  if [ "$restore_config" = 1 ] && [ "$empty" != 1 ]; then
    die "--restore-config requires --empty-install so database service credentials cannot diverge from an existing volume"
  fi
  if [ "$restore_config" != 1 ]; then
    for key in AUTH_SECRET TOPIC_VIEW_PREVIOUS_AUTH_SECRETS MAIL_PAYLOAD_KEY STORAGE_DRIVER; do
      current_value=$(env_get "$key")
      backup_value=$(sed -n "s/^$key=//p" "$temp/config.env" | tail -n 1)
      if [ "$key" = TOPIC_VIEW_PREVIOUS_AUTH_SECRETS ]; then
        [ -n "$current_value" ] || current_value='[]'
        [ -n "$backup_value" ] || backup_value='[]'
      fi
      [ "$current_value" = "$backup_value" ] || die "$key differs from the backup; use an empty install with --restore-config"
    done
    if [ "$(env_get STORAGE_DRIVER)" = s3 ]; then
      current_bucket=$(env_get S3_BUCKET)
      backup_bucket=$(sed -n 's/^S3_BUCKET=//p' "$temp/config.env" | tail -n 1)
      [ "$current_bucket" = "$backup_bucket" ] || die "S3_BUCKET differs from the backup"
    fi
  fi
  confirm_destructive "Restore will replace the current NextBuf database and local attachments."

  compose stop web worker >/dev/null
  if service_is_running web || service_is_running worker; then
    die "Web or Worker is still running; restore aborted"
  fi
  if [ "$empty" = 1 ]; then
    compose down -v
  fi
  if [ "$restore_config" = 1 ]; then
    cp "$temp/config.env" "$ENV_FILE"
    chmod 600 "$ENV_FILE"
  fi
  compose up -d postgres redis
  wait_for_service postgres 180
  wait_for_service redis 120
  compose exec -T postgres sh -ec 'psql -U "$POSTGRES_USER" -d "$POSTGRES_DB" -v ON_ERROR_STOP=1 -c "DROP SCHEMA public CASCADE; CREATE SCHEMA public;"'
  compose exec -T postgres sh -ec 'exec pg_restore -U "$POSTGRES_USER" -d "$POSTGRES_DB" --no-owner --no-privileges --exit-on-error' <"$temp/database.dump"
  if [ -f "$temp/uploads.tar.gz" ]; then
    compose run --rm --no-deps --entrypoint sh setup -ec 'find /app/data/uploads -mindepth 1 -maxdepth 1 -exec rm -rf -- {} +; tar -C /app/data/uploads -xzf -' <"$temp/uploads.tar.gz"
    if [ -f "$temp/uploads.SHA256SUMS" ]; then
      if [ -s "$temp/uploads.SHA256SUMS" ]; then
        compose run --rm --no-deps --entrypoint sh setup -ec 'cd /app/data/uploads; sha256sum -c -' <"$temp/uploads.SHA256SUMS"
      elif compose run --rm --no-deps --entrypoint sh setup -ec 'find /app/data/uploads -type f -print -quit | grep -q .'; then
        die "attachment checksum manifest is empty but the archive contains files"
      fi
    fi
  fi
  compose run --rm setup
  compose up -d --no-deps web worker
  wait_for_service web 180
  wait_for_service worker 180
  rm -rf "$temp"
  trap - EXIT HUP INT TERM
  info "restore completed"
}

do_upgrade() {
  require_files
  target=${1:-}
  [ "$#" -gt 0 ] && shift
  upgrade_verify_objects=0
  if [ "${1:-}" = --verify-objects ]; then
    upgrade_verify_objects=1
    shift
  fi
  [ "$#" -eq 0 ] && is_exact_semver "$target" ||
    die "usage: ./nextbufctl upgrade <exact-version> [--verify-objects]"
  require_command realpath
  require_command sha256sum
  require_command id
  current=$(env_get NEXTBUF_VERSION)
  is_exact_semver "$current" || die "current NEXTBUF_VERSION is not an exact SemVer: $current"
  [ "$target" != "$current" ] || die "already running $target"
  [ "$(semver_compare "$current" "$target")" = -1 ] || die "downgrades are not supported by upgrade; use the documented restore procedure"
  if ! compose_for_version "$target" pull web worker setup migrate doctor; then
    die "image pull failed; configuration remains $current"
  fi
  if ! verify_image_version "$target"; then
    die "target image version probe failed; configuration remains $current"
  fi
  do_backup 1
  backup_path=$LAST_BACKUP
  upgrade_resume_web=$resume_web
  upgrade_resume_worker=$resume_worker
  upgrade_target_configured=0
  upgrade_migration_started=0
  upgrade_migration_marker_dir=
  upgrade_migration_marker=
  upgrade_pre_migration_abort() {
    upgrade_abort_status=$?
    [ "$upgrade_abort_status" -ne 0 ] || upgrade_abort_status=1
    trap - EXIT HUP INT TERM
    if [ -n "$upgrade_migration_marker" ] && [ -f "$upgrade_migration_marker" ]; then
      upgrade_migration_started=1
    fi
    if [ "$upgrade_migration_started" = 0 ]; then
      if [ "$upgrade_target_configured" = 1 ]; then
        env_set NEXTBUF_VERSION "$current" || true
      fi
      resume_app_services_best_effort "$upgrade_resume_web" "$upgrade_resume_worker"
    fi
    if [ -n "$upgrade_migration_marker_dir" ]; then
      rm -rf "$upgrade_migration_marker_dir"
    fi
    exit "$upgrade_abort_status"
  }
  trap upgrade_pre_migration_abort EXIT HUP INT TERM
  evidence_stamp=$(date -u +%Y%m%dT%H%M%SZ)
  evidence_prefix="$BACKUP_DIR/acceptance-$current-to-$target-$evidence_stamp-$$"
  before_snapshot="$evidence_prefix-before.json"
  after_snapshot="$evidence_prefix-after.json"
  comparison_report="$evidence_prefix-comparison.json"
  if ! capture_acceptance_snapshot "$target" "$before_snapshot" "$upgrade_verify_objects"; then
    die "pre-upgrade acceptance snapshot failed before migration; configuration remains $current"
  fi
  write_evidence_checksum "$before_snapshot"
  upgrade_target_configured=1
  env_set NEXTBUF_VERSION "$target"
  upgrade_log="$BACKUP_DIR/upgrade-$current-to-$target-$(date -u +%Y%m%dT%H%M%SZ)-$$.log"
  upgrade_migration_marker_dir=$(mktemp -d "$BACKUP_DIR/.nextbuf-upgrade.XXXXXX")
  # The image runs as uid 1000. The 700 evidence root still prevents host traversal;
  # this mounted scratch directory grants only write/execute to the container uid.
  chmod 733 "$upgrade_migration_marker_dir"
  upgrade_migration_marker="$upgrade_migration_marker_dir/migration-started"
  if ! compose run --rm \
    -e NEXTBUF_MIGRATION_START_MARKER=/nextbuf-upgrade/migration-started \
    -v "$upgrade_migration_marker_dir:/nextbuf-upgrade" \
    setup >"$upgrade_log" 2>&1; then
    if [ -f "$upgrade_migration_marker" ]; then upgrade_migration_started=1; fi
    cat "$upgrade_log" >&2
    if [ "$upgrade_migration_started" = 1 ]; then
      die "upgrade setup failed after the target setup started; Web and Worker remain stopped and NEXTBUF_VERSION remains $target. Retry setup or explicitly restore $backup_path. Log: $upgrade_log"
    fi
    die "upgrade setup container did not start; configuration and previously running services will be restored to $current. Log: $upgrade_log"
  fi
  upgrade_migration_started=1
  [ -f "$upgrade_migration_marker" ] ||
    die "target setup did not confirm the migration-start boundary; Web and Worker remain stopped. Explicitly restore $backup_path. Log: $upgrade_log"
  if ! capture_acceptance_snapshot "$target" "$after_snapshot" "$upgrade_verify_objects"; then
    die "post-upgrade acceptance snapshot failed; Web and Worker remain stopped. Explicitly restore $backup_path unless the failure can be diagnosed without changing data. Log: $upgrade_log"
  fi
  write_evidence_checksum "$after_snapshot"
  if ! compare_acceptance_snapshots \
    "$target" "$before_snapshot" "$after_snapshot" "$comparison_report"; then
    if [ -f "$comparison_report" ]; then
      write_evidence_checksum "$comparison_report" || true
      cat "$comparison_report" >&2
    fi
    die "upgrade acceptance comparison found invariant changes; Web and Worker remain stopped. Explicitly restore $backup_path. Report: $comparison_report"
  fi
  write_evidence_checksum "$comparison_report"
  if ! compose up -d --no-deps web worker >>"$upgrade_log" 2>&1 ||
    ! (wait_for_service web 180 && wait_for_service worker 180); then
    compose logs --no-color --tail 200 web worker >>"$upgrade_log" 2>&1 || true
    if ! compose stop web worker >/dev/null 2>&1 || service_is_running web || service_is_running worker; then
      die "target services are unhealthy and could not be stopped; inspect them immediately. NEXTBUF_VERSION remains $target. Log: $upgrade_log"
    fi
    die "target services did not become healthy; Web and Worker remain stopped and NEXTBUF_VERSION remains $target. Explicitly restore $backup_path unless the release notes permit a code-only retry. Log: $upgrade_log"
  fi
  trap - EXIT HUP INT TERM
  rm -rf "$upgrade_migration_marker_dir"
  info "upgrade completed: $current -> $target (log: $upgrade_log; evidence: $comparison_report)"
}

command_name=${1:-help}
if [ "$#" -gt 0 ]; then shift; fi
case "$command_name" in
  help|-h|--help)
    printf '%s\n' 'Usage: ./nextbufctl <init|start|stop|status|logs|doctor|backup|restore|upgrade|acceptance>'
    exit 0
    ;;
esac
require_command docker
case "$command_name" in
  init|start|stop|backup|restore|upgrade|acceptance) acquire_operation_lock ;;
esac
case "$command_name" in
  init) do_init "$@" ;;
  start) do_start "$@" ;;
  stop) do_stop "$@" ;;
  status) do_status "$@" ;;
  logs) do_logs "$@" ;;
  doctor) do_doctor "$@" ;;
  backup) [ "$#" -eq 0 ] || die "usage: ./nextbufctl backup"; do_backup 0 ;;
  restore) do_restore "$@" ;;
  upgrade) do_upgrade "$@" ;;
  acceptance) do_acceptance "$@" ;;
  *) die "unknown command: $command_name" ;;
esac
